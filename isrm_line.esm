                  }
                },
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "seg_emis",
                        "r"
                      ]
                    },
                    {
                      "op": "apply_expression_template",
                      "args": [],
                      "name": "length_share",
                      "bindings": {
                        "lx": "line_x",
                        "ly": "line_y",
                        "xmin": "src_W",
                        "ymin": "src_S",
                        "xmax": "src_E",
                        "ymax": "src_N",
                        "eps": "clip_eps"
                      }
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "conc_PrimaryPM25",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "rcv"
            ],
            "reduce": "+",
            "ranges": {
              "s": {
                "from": "src_cells"
              },
              "rcv": {
                "from": "rcv_cells"
              }
            },
            "args": [
              "SR_PrimaryPM25_L0",
              "E_PM25"
            ],
            "expr": {
              "op": "apply_expression_template",
              "args": [],
              "name": "sr_matvec",
              "bindings": {
                "A": "SR_PrimaryPM25_L0",
                "E": "E_PM25"
              }
            }
          }
        },
        {
          "lhs": "pm_PrimaryPM25",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "rcv"
            ],
            "ranges": {
              "rcv": {
                "from": "rcv_cells"
              }
            },
            "args": [
              "conc_PrimaryPM25"
            ],
            "expr": {
              "op": "apply_expression_template",
              "args": [],
              "name": "to_ug_m3",
              "bindings": {
                "x": "conc_PrimaryPM25"
              }
            }
          }
        },
        {
          "lhs": "TotalPM25",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "rcv"
            ],
            "ranges": {
              "rcv": {
                "from": "rcv_cells"
              }
            },
            "args": [
              "conc_PrimaryPM25"
            ],
            "expr": {
