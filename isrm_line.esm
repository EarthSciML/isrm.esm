              "line_y",
              "seg_emis",
              "clip_eps"
            ],
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "cell_overlaps_box",
                  "bindings": {
                    "xmin": "src_W",
                    "ymin": "src_S",
                    "xmax": "src_E",
                    "ymax": "src_N",
                    "bxmin": "seg_xmin",
                    "bymin": "seg_ymin",
                    "bxmax": "seg_xmax",
