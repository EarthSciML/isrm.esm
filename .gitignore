# Bulk input data stays untracked — the EGU FF10 zip lives at
# data/2016fd_inputs_point.zip (see README "Prerequisites" for the download),
# and data/polygon_emissions_*.zip / data/line_emissions_*.zip are REBUILT by
# the scripts below rather than committed. The scripts themselves are source,
# so they are tracked.
data/*
!data/make_polygon_layer.py
!data/make_line_layer.py
!data/make_gdf_documents.py
__pycache__/
*.pyc

# Agent worktrees (git worktree add .claude/worktrees/...)
.claude/

# Generated by run-api/run_isrm_demo.py (PNGs, and any spilled values).
run-api/out/
run-api/.venv/
