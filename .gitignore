# Bulk input data stays untracked — the EGU FF10 zip lives at
# data/2016fd_inputs_point.zip (see README "Prerequisites" for the download),
# and data/polygon_emissions_*.zip is REBUILT by the script below rather than
# committed. The script itself is source, so it is tracked.
data/*
!data/make_polygon_layer.py
__pycache__/
*.pyc

# Agent worktrees (git worktree add .claude/worktrees/...)
.claude/
