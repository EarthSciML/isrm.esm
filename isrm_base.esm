                                                ]
                                              },
                                              2.0
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "op": "apply_expression_template",
                                    "args": [],
                                    "name": "lcc_cone_n",
                                    "bindings": {}
                                  }
