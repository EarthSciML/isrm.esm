                                    ]
                                  }
                                ]
                              },
                              {
                                "op": "^",
                                "args": [
                                  {
                                    "op": "tan",
                                    "args": [
                                      {
                                        "op": "+",
                                        "args": [
                                          "lcc_qp",
                                          {
                                            "op": "/",
                                            "args": [
                                              {
                                                "op": "*",
                                                "args": [
                                                  "lat_1",
