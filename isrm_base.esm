    "cell_at_model_layer": {
      "description": "Gather `fld` at model layer `layer` above source cell c. The InMAP grid is laid out LAYER-MAJOR over all_cells, and layers 0-7 share a byte-identical horizontal grid of N_SRC cells, so the cell above c in layer k is the flat offset k*N_SRC + c. `layer` may be an integer literal or a per-record expression.",
      "params": [
        "fld",
        "layer"
      ],
      "body": {
        "op": "index",
        "args": [
          "fld",
          {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "layer",
                  "N_SRC"
                ]
              },
              "c"
            ]
          }
        ]
      }
    },
    "sr_matvec": {
      "description": "One source-receptor contraction term: SR array `A`[s, rcv] times the per-source-cell emission `E`[s]. The enclosing aggregate stays authored in the consuming document \u2014 the projection-pushdown rewrite re-points its reduction axis onto the derived support set and cannot reach into a shared template body to do it.",
      "params": [
        "A",
        "E"
      ],
      "body": {
        "op": "*",
        "args": [
          {
            "op": "index",
            "args": [
              "A",
              "s",
              "rcv"
            ]
          },
          {
            "op": "index",
            "args": [
              "E",
              "s"
            ]
          }
        ]
      }
    },
    "sum_sr_layers": {
      "description": "Sum a per-SR-emission-layer triple at receptor rcv. The three SR emission layers are the model layers [0, SR_MODEL_L1, SR_MODEL_L2].",
      "params": [
        "l0",
        "l1",
        "l2"
      ],
      "body": {
        "op": "+",
        "args": [
          {
            "op": "index",
            "args": [
              "l0",
              "rcv"
            ]
          },
          {
            "op": "index",
            "args": [
              "l1",
              "rcv"
            ]
          },
          {
            "op": "index",
            "args": [
              "l2",
              "rcv"
            ]
          }
        ]
      }
    },
    "to_ug_m3": {
      "description": "Scale a contracted concentration at receptor rcv by `fact`, the short-tons-per-year to ug/s emission conversion the SR matrix expects. `fact` is a free name the consuming document declares.",
      "params": [
        "x"
      ],
      "body": {
        "op": "*",
        "args": [
          "fact",
          {
            "op": "index",
            "args": [
              "x",
              "rcv"
            ]
          }
        ]
      }
    },
    "krewski_deaths": {
      "description": "PM2.5-attributable deaths at receptor rcv from a log-linear concentration-response function: (exp(log(rr)/10 * pm) - 1) * population * baseline mortality. `rr` is the relative risk per 10 ug/m3. Free names: TotalPop, MortalityRate, pop_scale, mort_scale.",
      "params": [
        "rr",
        "pm"
      ],
      "body": {
        "op": "*",
        "args": [
          {
            "op": "*",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "exp",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  {
                                    "op": "log",
                                    "args": [
                                      "rr"
                                    ]
                                  },
                                  10
                                ]
                              },
                              {
                                "op": "index",
                                "args": [
                                  "pm",
                                  "rcv"
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      1
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "index",
                        "args": [
                          "TotalPop",
                          "rcv"
                        ]
                      },
                      "pop_scale"
                    ]
                  }
                ]
              },
              {
                "op": "/",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "MortalityRate",
                      "rcv"
                    ]
                  },
                  100000
                ]
              }
            ]
          },
          "mort_scale"
        ]
      }
    },
    "receptor_edge": {
      "description": "A receptor cell's rectangle edge, sliced out of the full-grid array `edge` (the receptor set is the leading N_RCV cells of the InMAP grid).",
      "params": [
        "edge"
      ],
      "body": {
        "op": "index",
        "args": [
          "edge",
          "rcv"
        ]
      }
    },
    "receptor_centre": {
      "description": "A receptor cell's centre coordinate, the midpoint of its `lo` and `hi` rectangle edges.",
      "params": [
        "lo",
        "hi"
      ],
      "body": {
        "op": "/",
        "args": [
          {
            "op": "+",
            "args": [
              {
                "op": "index",
                "args": [
                  "lo",
                  "rcv"
                ]
              },
              {
                "op": "index",
                "args": [
                  "hi",
                  "rcv"
                ]
              }
            ]
          },
          2
        ]
      }
    }
  }
}
