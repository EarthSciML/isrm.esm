            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "lcc_R",
                      {
                        "op": "/",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              {
                                "op": "cos",
                                "args": [
                                  {
                                    "op": "*",
                                    "args": [
                                      "lat_1",
