    "cell_at_model_layer": {
      "description": "Gather `fld` at model layer `layer` above source cell c. The InMAP grid is laid out LAYER-MAJOR over all_cells, and layers 0-7 share a byte-identical horizontal grid of N_SRC cells, so the cell above c in layer k is the flat offset k*N_SRC + c. `layer` may be an integer literal or a per-record expression.",
      "params": [
        "fld",
        "layer"
      ],
      "body": {
        "op": "index",
        "args": [
          "fld",
          {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "layer",
                  "N_SRC"
                ]
              },
              "c"
            ]
          }
        ]
      }
    },
    "sr_matvec": {
      "description": "One source-receptor contraction term: SR array `A`[s, rcv] times the per-source-cell emission `E`[s]. The enclosing aggregate stays authored in the consuming document \u2014 the projection-pushdown rewrite re-points its reduction axis onto the derived support set and cannot reach into a shared template body to do it.",
      "params": [
        "A",
        "E"
      ],
      "body": {
        "op": "*",
        "args": [
          {
            "op": "index",
            "args": [
              "A",
              "s",
              "rcv"
            ]
          },
          {
            "op": "index",
            "args": [
              "E",
              "s"
            ]
          }
        ]
      }
    },
    "sum_sr_layers": {
      "description": "Sum a per-SR-emission-layer triple at receptor rcv. The three SR emission layers are the model layers [0, SR_MODEL_L1, SR_MODEL_L2].",
      "params": [
        "l0",
        "l1",
        "l2"
      ],
      "body": {
        "op": "+",
        "args": [
          {
            "op": "index",
            "args": [
              "l0",
              "rcv"
            ]
          },
          {
            "op": "index",
            "args": [
              "l1",
              "rcv"
            ]
          },
          {
            "op": "index",
            "args": [
              "l2",
              "rcv"
            ]
          }
        ]
      }
    },
    "to_ug_m3": {
      "description": "Scale a contracted concentration at receptor rcv by `fact`, the short-tons-per-year to ug/s emission conversion the SR matrix expects. `fact` is a free name the consuming document declares.",
      "params": [
        "x"
      ],
      "body": {
        "op": "*",
        "args": [
          "fact",
          {
            "op": "index",
            "args": [
              "x",
              "rcv"
            ]
          }
        ]
      }
    },
    "krewski_deaths": {
      "description": "PM2.5-attributable deaths at receptor rcv from a log-linear concentration-response function: (exp(log(rr)/10 * pm) - 1) * population * baseline mortality. `rr` is the relative risk per 10 ug/m3. Free names: TotalPop, MortalityRate, pop_scale, mort_scale.",
      "params": [
        "rr",
        "pm"
      ],
      "body": {
        "op": "*",
        "args": [
          {
            "op": "*",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "exp",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  {
                                    "op": "log",
                                    "args": [
                                      "rr"
                                    ]
                                  },
                                  10
                                ]
                              },
                              {
                                "op": "index",
                                "args": [
                                  "pm",
                                  "rcv"
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      1
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "index",
                        "args": [
                          "TotalPop",
                          "rcv"
                        ]
                      },
                      "pop_scale"
                    ]
                  }
                ]
              },
              {
                "op": "/",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "MortalityRate",
                      "rcv"
                    ]
                  },
                  100000
                ]
              }
            ]
          },
          "mort_scale"
        ]
      }
    },
    "receptor_edge": {
      "description": "A receptor cell's rectangle edge, sliced out of the full-grid array `edge` (the receptor set is the leading N_RCV cells of the InMAP grid).",
      "params": [
        "edge"
      ],
      "body": {
        "op": "index",
        "args": [
          "edge",
          "rcv"
        ]
      }
    },
    "receptor_centre": {
      "description": "A receptor cell's centre coordinate, the midpoint of its `lo` and `hi` rectangle edges.",
      "params": [
        "lo",
        "hi"
      ],
      "body": {
        "op": "/",
        "args": [
          {
            "op": "+",
            "args": [
              {
                "op": "index",
                "args": [
                  "lo",
                  "rcv"
                ]
              },
              {
                "op": "index",
                "args": [
                  "hi",
                  "rcv"
                ]
              }
            ]
          },
          2
        ]
      }
    },
    "cell_overlaps_box": {
      "description": "1.0 when cell c's rectangle [xmin, xmax] x [ymin, ymax] and record r's envelope [bxmin, bxmax] x [bymin, bymax] overlap, else 0.0. This is the AREA-source counterpart of `cell_contains_point`: a polygon or a line touches many cells, so the binning aggregate's gate is a rectangle overlap rather than a containment, and it is CLOSED on every edge (a shared boundary is a candidate pair on both sides) because the gate is a BROAD PHASE - the exact share is decided afterwards by `polygon_intersection_area`, which returns 0 for a touching-but-not-overlapping pair. Conservative is the requirement; tight is not. Like `cell_contains_point` this must stay a conjunction of comparisons between a cell-indexed bound and a record-indexed bound, in this argument order: it is what the projection-pushdown recogniser reads off the enclosing aggregate to derive the emission-bearing support set and the SR gate (CONFORMANCE_SPEC 5.5.6, envelope arity 4).",
      "params": [
        "xmin",
        "ymin",
        "xmax",
        "ymax",
        "bxmin",
        "bymin",
        "bxmax",
        "bymax"
      ],
      "body": {
        "op": "ifelse",
        "args": [
          {
            "op": "and",
            "args": [
              {
                "op": "<=",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "xmin",
                      "c"
                    ]
                  },
                  {
                    "op": "index",
                    "args": [
                      "bxmax",
                      "r"
                    ]
                  }
                ]
              },
              {
                "op": "<=",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "bxmin",
                      "r"
                    ]
                  },
                  {
                    "op": "index",
                    "args": [
                      "xmax",
                      "c"
                    ]
                  }
                ]
              },
              {
                "op": "<=",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "ymin",
                      "c"
                    ]
                  },
                  {
                    "op": "index",
                    "args": [
                      "bymax",
                      "r"
                    ]
                  }
                ]
              },
              {
                "op": "<=",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "bymin",
                      "r"
                    ]
                  },
                  {
                    "op": "index",
                    "args": [
                      "ymax",
                      "c"
                    ]
                  }
                ]
              }
            ]
          },
          1.0,
          0.0
        ]
      }
    },
    "ring_xy": {
      "description": "One component of a ring vertex: `x` when the xy-axis symbol `d` is at position 1, `y` when it is at position 2. Written as a dot product with two inline `const` selectors rather than `ifelse(d == 1, x, y)` because an index symbol is a POSITION, not a value: routing every use of `d` through an `index(...)` slot is the spelling all three bindings agree on. Both branches are evaluated either way - `ifelse` does not guard its arms inside an `aggregate` in any binding - so the selector costs nothing the conditional would have saved. `x` and `y` are bound to expressions, not names, so the caller decides where the coordinates come from.",
      "params": [
        "x",
        "y"
      ],
      "body": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              {
                "op": "index",
                "args": [
                  {
                    "op": "const",
                    "value": [
                      1.0,
                      0.0
                    ],
                    "args": []
                  },
                  "d"
                ]
              },
              "x"
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "index",
                "args": [
                  {
                    "op": "const",
                    "value": [
                      0.0,
                      1.0
                    ],
                    "args": []
                  },
                  "d"
                ]
              },
              "y"
            ]
          }
        ]
      }
    },
    "rect_ring_xy": {
      "description": "Cell c's rectangle as a four-vertex RING, evaluated at ring-vertex `v` and xy component `d`: (xmin, ymin), (xmax, ymin), (xmax, ymax), (xmin, ymax) - counter-clockwise, no closing duplicate (`polygon_intersection_area` closes the ring implicitly, esm-spec 8.6.1). The four inline `const` selectors pick which edge each corner takes from, for the same reason `ring_xy` uses them. A grid of rectangles has no ring array on disk; this is how a document makes one, and the result is an ordinary cell-axis array the projection-pushdown rewrite gathers onto the derived support set along with the envelope bounds (CONFORMANCE_SPEC 5.5.7).",
      "params": [
        "xmin",
        "ymin",
        "xmax",
        "ymax"
      ],
      "body": {
        "op": "apply_expression_template",
        "args": [],
        "name": "ring_xy",
        "bindings": {
          "x": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      {
                        "op": "const",
                        "value": [
                          1.0,
                          0.0,
                          0.0,
                          1.0
                        ],
                        "args": []
                      },
                      "v"
                    ]
                  },
                  {
                    "op": "index",
                    "args": [
                      "xmin",
                      "c"
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      {
                        "op": "const",
                        "value": [
                          0.0,
                          1.0,
                          1.0,
                          0.0
                        ],
                        "args": []
                      },
                      "v"
                    ]
                  },
                  {
                    "op": "index",
                    "args": [
                      "xmax",
                      "c"
                    ]
                  }
                ]
              }
            ]
          },
          "y": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      {
                        "op": "const",
                        "value": [
                          1.0,
                          1.0,
                          0.0,
                          0.0
                        ],
                        "args": []
                      },
                      "v"
                    ]
                  },
                  {
                    "op": "index",
                    "args": [
                      "ymin",
                      "c"
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      {
                        "op": "const",
                        "value": [
                          0.0,
                          0.0,
                          1.0,
                          1.0
                        ],
                        "args": []
                      },
                      "v"
                    ]
                  },
                  {
                    "op": "index",
                    "args": [
                      "ymax",
                      "c"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "area_share": {
      "description": "The fraction of record r's polygon that lies inside cell c: the overlap area of `rec_ring`[r] with `cell_ring`[c] over the record's own area `rec_area`[r]. This is the AREA-WEIGHTED allocation an area source needs, and it is mass-conserving: summed over a cell set that covers the polygon the shares are 1, so a polygon lying entirely inside the grid delivers exactly its declared emission. Both operands are vertex rings in the SAME planar coordinate system - project first, then clip - so `manifold: planar` is the honest choice, and the projection's local scale factor cancels in the ratio. OPERAND ORDER IS LOAD-BEARING AND NOT SYMMETRIC: `polygon_intersection_area(a, b)` clips subject `a` against `b`, and the planar kernel is a Sutherland-Hodgman clipper, which requires the CLIP operand to be CONVEX and silently returns the convex-hull-edge intersection when it is not. A grid cell is an axis-aligned rectangle and always convex; a real-world polygon - a county, a watershed, a state - very often is not. So the record ring is the subject and the cell ring is the clip, never the other way round. Measured on the shipped Illinois layer, getting this backwards understates a non-convex county's area by up to 4x, and does it CONSISTENTLY in numerator and denominator, so the shares still sum to 1 and mass conservation does not catch it.",
      "params": [
        "cell_ring",
        "rec_ring",
        "rec_area"
      ],
      "body": {
        "op": "/",
        "args": [
          {
            "op": "polygon_intersection_area",
            "manifold": "planar",
            "args": [
              {
                "op": "index",
                "args": [
                  "rec_ring",
                  "r"
                ]
              },
              {
                "op": "index",
                "args": [
                  "cell_ring",
                  "c"
                ]
              }
            ]
          },
          {
            "op": "index",
            "args": [
              "rec_area",
              "r"
            ]
          }
        ]
      }
    },
    "ring_cross_term": {
      "description": "One shoelace term of record r's ring at segment v: x[r,v]*y[r,v+1] - x[r,v+1]*y[r,v]. Summed over the ring's segments and halved in absolute value it is the ring's planar area. WHY NOT `polygon_intersection_area` OF A RING WITH ITSELF: that is the natural spelling and it is WRONG for a non-convex ring, because the planar kernel clips against a convex clip operand and a ring clipped against itself makes itself the clip (see `area_share`). The shoelace has no convexity precondition, is exact in the ring's own coordinates, and needs no geometry kernel at all. TWO PROPERTIES OF THE STORED RING MAKE IT CORRECT AS WRITTEN. First, the sum omits the wrap term x[N]*y[1] - x[1]*y[N]: an ESRI shapefile ring is EXPLICITLY CLOSED (the Shapefile Technical Description requires the final vertex to repeat the first) and the reader preserves that vertex, so the closing edge is already one of the segments and the omitted term is the cross product of the first vertex with itself, which is zero. Second, the right-padding that fills a short ring out to the declared width repeats the FINAL vertex - which is the first vertex - so every padded segment contributes the cross product of a point with itself, also zero. The segment range must therefore be one SHORTER than the vertex axis, so that v+1 stays in bounds.",
      "params": [
        "x",
        "y"
      ],
      "body": {
        "op": "-",
        "args": [
          {
            "op": "*",
            "args": [
              {
                "op": "index",
                "args": [
                  "x",
                  "r",
                  "v"
                ]
              },
              {
                "op": "index",
                "args": [
                  "y",
                  "r",
                  {
                    "op": "+",
                    "args": [
                      "v",
                      1
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "index",
                "args": [
                  "x",
                  "r",
                  {
                    "op": "+",
                    "args": [
                      "v",
                      1
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "y",
                  "r",
                  "v"
                ]
              }
            ]
          }
        ]
      }
    },
    "seg_length": {
      "description": "The planar length of record r's two-vertex segment: hypot of the differences of its endpoints, sqrt((lx[r,2]-lx[r,1])^2 + (ly[r,2]-ly[r,1])^2). `lx` and `ly` are [record, vertex] coordinate arrays in PROJECTED metres, so this is a planar length in the grid's own units and directly comparable to a cell edge. It is deliberately not the geodesic length the layer's LEN_KM column carries: that one is measured on the ellipsoid before projection, and over Illinois the two differ by about half a percent. What the allocation needs is the length in the SAME coordinates the clipping happens in, so that a segment's share of itself inside a cell and its share of its parent road are consistent. Two vertices, not a loop: the record IS a segment, so there is no vertex axis to reduce over here - see the one-row-per-segment note in isrm_line.esm.",
      "params": [
        "lx",
        "ly"
      ],
      "body": {
        "op": "sqrt",
        "args": [
          {
            "op": "+",
            "args": [
              {
                "op": "^",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "index",
                        "args": [
                          "lx",
                          "r",
                          2
                        ]
                      },
                      {
                        "op": "index",
                        "args": [
                          "lx",
                          "r",
                          1
                        ]
                      }
                    ]
                  },
                  2.0
                ]
              },
              {
                "op": "^",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "index",
                        "args": [
                          "ly",
                          "r",
                          2
                        ]
                      },
                      {
                        "op": "index",
                        "args": [
                          "ly",
                          "r",
                          1
                        ]
                      }
                    ]
                  },
                  2.0
                ]
              }
            ]
          }
        ]
      }
    },
    "length_share": {
      "description": "The fraction of record r's segment that lies inside cell c's rectangle [xmin, xmax] x [ymin, ymax] - the LINE counterpart of `area_share`, and like it the weight that makes the allocation mass-conserving: the shares of one segment over a cell set that covers it sum to 1, so a segment lying entirely inside the grid delivers exactly its emission and one hanging off the edge loses exactly the part that hangs off. It needs no denominator, unlike `area_share`: the clip is done in the segment's own PARAMETER t, which runs 0 to 1 from the first endpoint to the second, so the clipped interval's width IS the share and the length cancels before it is ever formed. THE ALGORITHM is Liang-Barsky. Each of the rectangle's two slabs gives the segment two parameter values; the entry is the largest of the slab minima and 0, the exit the smallest of the slab maxima and 1, and the share is their gap clamped at 0 - empty when the entry passes the exit, which is exactly the 'misses the cell' case. There is no polygon kernel here at all, so none of the convexity and vertex-tolerance caveats that attend `area_share` apply; a cell rectangle and a straight segment are both exactly representable and the whole computation is four divisions and a handful of comparisons. WHY THE DIVISORS ARE FLOORED: a segment parallel to an axis has a zero component and would divide by zero, and `ifelse` does not guard its arms inside an `aggregate` in any binding, so the division cannot be conditional - it has to be safe. `eps` floors the magnitude of each component WITHOUT flipping its sign, which turns a parallel segment's two slab parameters into a matched pair of very large values: opposite in sign when the segment lies inside that slab, so the slab imposes no constraint, and the same sign and outside [0,1] when it does not, so the share is 0. Both are the right answers, reached without a branch. `eps` should be far below any real coordinate difference - a nanometre against metres - so that the floor engages only where the exact answer is a limit anyway.",
      "params": [
        "lx",
        "ly",
        "xmin",
        "ymin",
        "xmax",
        "ymax",
        "eps"
      ],
      "body": {
        "op": "max",
        "args": [
          {
            "op": "-",
            "args": [
              {
                "op": "min",
                "args": [
                  1.0,
                  {
                    "op": "max",
