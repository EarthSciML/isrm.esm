  "Emis": {
   "kind": "static",
   "source": {
    "url_template": "REPLACED-BY-THE-CALLER"
   },
   "reference": {
    "notes": "The caller's own point emissions, written out of a GeoDataFrame as a zipped shapefile set and uploaded as an EarthSciLab dataset. The url is a placeholder: a dispatched run reads the document's own loaders, so the caller rewrites this with the dataset's store url before it sends the document. There is no upstream copy to point at, because the layer is the caller's."
   },
   "metadata": {
    "esio_format": "shapefile",
    "tags": [
     "shapefile",
     "point",
     "emissions",
     "user_supplied"
    ],
    "x_esd": {
     "format": "shapefile",
     "container": "zip",
     "crs": "EPSG:4269",
     "note": "The reader is READER-ONLY: it decodes rings and .dbf columns and declares the file's CRS, and it reprojects nothing. `member` names the .shp inside the zip (the .dbf/.shx/.prj sidecars are the same stem) and never enters the cache key. `nvert_max` is the DECLARED vertex-axis width: every part is right-padded to it by repeating its final vertex, and the reader raises rather than silently widening, so the caller computes it from the frame it is about to write. One row per shapefile PART, with the record's .dbf attributes replicated.",
     "columns": {
      "PM25": "kg/yr",
      "VOC": "kg/yr",
      "NOx": "kg/yr",
      "NH3": "kg/yr",
      "SOx": "kg/yr",
      "STKHGT": "m",
      "STKDIAM": "m",
      "STKTEMP": "K",
      "STKVEL": "m/s"
     }
    }
   },
   "reader_options": {
    "member": "emis.shp",
    "nvert_max": 1
   },
   "extent": {
    "metaparameter": "N_REC"
   }
  }
 },
 "models": {
  "ISRM": {
   "system_kind": "nonlinear",
   "expression_template_imports": [
    {
     "ref": "./isrm_base.esm"
    }
   ],
   "reference": {
    "url": "https://inmap.run/blog/2022/12/15/tutorial/",
    "notes": "Pure algebraic (no ODE state); every result is an observed."
   },
   "variables": {
    "W": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell west edge (LCC m); from ISRM_Grid.W (full 596444, prefix used).",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "W"
      }
     }
    },
    "S": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell south edge (LCC m); from ISRM_Grid.S.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "S"
      }
     }
    },
    "E": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell east edge (LCC m); from ISRM_Grid.E.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "E"
      }
     }
    },
    "N": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell north edge (LCC m); from ISRM_Grid.N.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "N"
      }
     }
    },
    "TotalPop": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Population per cell; from ISRM_Grid.TotalPop (read on the rcv range = [0:52411] prefix slice).",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "TotalPop"
      }
     }
    },
    "MortalityRate": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Baseline mortality per 100k; from ISRM_Grid.MortalityRate (prefix [0:52411]).",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "MortalityRate"
      }
     }
    },
    "Temperature": {
     "type": "parameter",
     "units": "K",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Air temperature in each cell. From ISRM_Grid.Temperature: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "Temperature"
      }
     }
    },
    "WindSpeed": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Wind speed in each cell. From ISRM_Grid.WindSpeed: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "WindSpeed"
      }
     }
    },
    "WindSpeedInverse": {
     "type": "parameter",
     "units": "s/m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell mean of 1/u, the average InMAP takes over the wind rose rather than the reciprocal of the mean speed. From ISRM_Grid.WindSpeedInverse: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "WindSpeedInverse"
      }
     }
    },
    "WindSpeedMinusThird": {
     "type": "parameter",
     "units": "(m/s)^(-1/3)",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell mean of u^(-1/3). From ISRM_Grid.WindSpeedMinusThird: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "WindSpeedMinusThird"
      }
     }
    },
    "WindSpeedMinusOnePointFour": {
     "type": "parameter",
     "units": "(m/s)^-1.4",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell mean of u^(-1.4). From ISRM_Grid.WindSpeedMinusOnePointFour: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "WindSpeedMinusOnePointFour"
      }
     }
    },
    "S1": {
     "type": "parameter",
     "units": "1/s^2",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Stability parameter S1 = (g/theta) dtheta/dz, the buoyancy frequency squared that scales the stable-plume rise. From ISRM_Grid.S1: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "S1"
      }
     }
    },
    "SClass": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Stability class indicator: > 0.5 marks a stably stratified cell. From ISRM_Grid.SClass: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "SClass"
      }
     }
    },
    "LayerHeight": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Staggered layer-BOTTOM height: LayerHeight[l, c] is the height of the bottom of model layer l over cell c, and layer 0's is 0. This is the column InMAP's findLayer searches. From ISRM_Grid.LayerHeight: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "LayerHeight"
      }
     }
    },
    "Dz": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Layer THICKNESS: Dz[l, c] is the vertical extent of model layer l over cell c, so LayerHeight[l, c] + Dz[l, c]/2 is that layer's CENTRE height — which is the column InMAP's sr.Reader.layerFracs interpolates on (sr.d.VerticalProfile fills height[i] = c.LayerHeight + c.Dz/2). Length 596444 (N_ALL), layer-major over all 27 model layers. From ISRM_Grid.Dz: one value per cell of the full 596444-cell grid, so `l*N_SRC + c` reaches layer l of source cell c.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "Dz"
      }
     }
    },
    "fact": {
     "type": "parameter",
     "units": "1",
     "default": 31.709791983764585,
     "description": "kg/yr -> ug/s: 1e9 ug/kg over 3.1536e7 s/yr. The published documents' 28766.639396245562 is this times 907.18474 kg per short ton, so reading SI changes this constant and nothing else."
    },
    "pop_scale": {
     "type": "parameter",
     "units": "1",
     "default": 1.0465819687408728,
     "description": "Population 2010->2016 rescale."
    },
    "mort_scale": {
     "type": "parameter",
     "units": "1",
     "default": 1.025229357798165,
     "description": "Mortality-rate 2005->2016 rescale."
    },
    "rr_K": {
     "type": "parameter",
     "units": "1",
     "default": 1.06,
     "description": "Krewski relative risk per 10 ug/m3 PM2.5."
    },
    "rr_L": {
     "type": "parameter",
     "units": "1",
     "default": 1.14,
     "description": "Lepeule relative risk per 10 ug/m3 PM2.5."
    },
    "lat_1": {
     "type": "parameter",
     "units": "degree",
     "default": 33.0,
     "description": "LCC standard parallel 1 (NEI2016)."
    },
    "lat_2": {
     "type": "parameter",
     "units": "degree",
     "default": 45.0,
     "description": "LCC standard parallel 2 (NEI2016)."
    },
    "lat_0": {
     "type": "parameter",
     "units": "degree",
     "default": 40.0,
     "description": "LCC origin latitude (NEI2016)."
    },
    "lon_0": {
     "type": "parameter",
     "units": "degree",
     "default": -97.0,
     "description": "LCC central meridian (NEI2016)."
    },
    "lcc_R": {
     "type": "parameter",
     "units": "m",
     "default": 6370997.0,
     "description": "LCC sphere radius (NEI2016). (Named lcc_R, not R, to avoid the reserved physical-constant name R = ideal gas constant.)"
    },
    "lcc_d2r": {
     "type": "parameter",
     "default": 0.017453292519943295,
     "description": "degrees->radians (pi/180) for the LCC projection."
    },
    "lcc_qp": {
     "type": "parameter",
     "default": 0.7853981633974483,
     "description": "pi/4 quarter-turn offset for the LCC tan half-angle."
    },
    "src_W": {
     "type": "parameter",
     "shape": [
      "src_cells"
     ],
     "description": "source-cell rectangle W-edge (projected LCC meters), src_cells axis.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "W",
       "select": {
        "axes": [
         {
          "range": {
           "start": 0,
           "stop": "N_SRC"
          }
         }
        ]
       }
      }
     },
     "units": "m"
    },
    "src_S": {
     "type": "parameter",
     "shape": [
      "src_cells"
     ],
     "description": "source-cell rectangle S-edge (projected LCC meters), src_cells axis.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "S",
       "select": {
        "axes": [
         {
          "range": {
           "start": 0,
           "stop": "N_SRC"
          }
         }
        ]
       }
      }
     },
     "units": "m"
    },
    "src_E": {
     "type": "parameter",
     "shape": [
      "src_cells"
     ],
     "description": "source-cell rectangle E-edge (projected LCC meters), src_cells axis.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "E",
       "select": {
        "axes": [
         {
          "range": {
           "start": 0,
           "stop": "N_SRC"
          }
         }
        ]
       }
      }
     },
     "units": "m"
    },
    "src_N": {
     "type": "parameter",
     "shape": [
      "src_cells"
     ],
     "description": "source-cell rectangle N-edge (projected LCC meters), src_cells axis.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "N",
       "select": {
        "axes": [
         {
          "range": {
           "start": 0,
           "stop": "N_SRC"
          }
         }
        ]
       }
      }
     },
     "units": "m"
    },
    "X": {
     "type": "unknown",
     "shape": [
      "emis_records"
     ],
     "description": "Each source's projected x in the ISRM's Lambert conformal metres, from the shapefile's single vertex."
    },
    "Y": {
     "type": "unknown",
     "shape": [
      "emis_records"
     ],
     "description": "Each source's projected y in the ISRM's Lambert conformal metres, from the shapefile's single vertex."
    },
    "stk_height": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "emis_records"
     ],
     "description": "Stack height above ground. From Emis.STKHGT, already in m — the caller's frame carries SI, so the ft/degF conversions this document's parent needed are gone and ASME plume rise consumes the column directly.",
     "update": {
      "kind": "data",
      "source": "Emis",
      "from": {
       "file_variable": "STKHGT"
      }
     }
    },
    "stk_diam": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
