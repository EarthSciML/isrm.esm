   "analyses": [
    {
     "id": "isrm_demo",
     "description": "Static evaluation of the ISRM tutorial: TotalPM25 and attributable deaths at the 52411 receptor cells. Degenerate time span (no ODE integration).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "plots": [
      {
       "id": "totalpm25_map",
       "type": "scatter",
       "description": "TotalPM25 (ug/m3) vs receptor cell-centroid easting. The 52411-cell ISRM grid is an unstructured variable-resolution polygon mesh with a single flat index, so field_snapshot (structured lat-lon) does not apply and a true polygon choropleth is out of format scope (gap G5); scatter also has no per-point color channel, so the value is on the y-axis. x = LCC-metre cell-centroid easting.",
       "x": {
        "variable": "rcv_cx",
        "label": "receptor centroid x (m, LCC)"
       },
       "y": {
        "variable": "TotalPM25",
        "label": "PM2.5 (ug/m3)"
       }
      }
     ]
    }
   ]
  }
