     "description": "Per-receptor particulate sulfate response from the emissions that reach layer 0: sum_s SR_pSO4_L0[s,rcv]*E_SOx_L0[s] (pre-fact). A PLAIN TWO-FACTOR product summed over one contracted index, one observed per (pathway, layer) — folding the three layers into a single aggregate would make the rewrite's matvec detector reject this body (it requires op `*` with exactly two args) and drop the pathway from the SR gate silently."
    },
    "conc_pSO4_L1": {
     "type": "unknown",
     "units": "ug/m^3",
     "shape": [
      "rcv_cells"
     ],
     "description": "Per-receptor particulate sulfate response from the emissions that reach layer 1: sum_s SR_pSO4_L1[s,rcv]*E_SOx_L1[s] (pre-fact). A PLAIN TWO-FACTOR product summed over one contracted index, one observed per (pathway, layer) — folding the three layers into a single aggregate would make the rewrite's matvec detector reject this body (it requires op `*` with exactly two args) and drop the pathway from the SR gate silently."
    },
    "conc_pSO4_L2": {
     "type": "unknown",
     "units": "ug/m^3",
     "shape": [
      "rcv_cells"
     ],
     "description": "Per-receptor particulate sulfate response from the emissions that reach layer 2: sum_s SR_pSO4_L2[s,rcv]*E_SOx_L2[s] (pre-fact). A PLAIN TWO-FACTOR product summed over one contracted index, one observed per (pathway, layer) — folding the three layers into a single aggregate would make the rewrite's matvec detector reject this body (it requires op `*` with exactly two args) and drop the pathway from the SR gate silently."
    },
    "conc_pSO4": {
     "type": "unknown",
     "units": "ug/m^3",
     "shape": [
      "rcv_cells"
     ],
     "description": "Per-receptor concentration response from the particulate sulfate pathway, summed over the three SR emission layers: conc_pSO4_L0 + conc_pSO4_L1 + conc_pSO4_L2. The layer split is where plume rise shows up in the answer."
    },
    "pm_pSO4": {
     "type": "unknown",
     "units": "ug/m^3",
     "shape": [
      "rcv_cells"
     ],
     "description": "Reported pSO4 PM2.5 component at each receptor: fact*conc_pSO4."
    }
   },
