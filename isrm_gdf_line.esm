   "equations": [
    {
     "lhs": "line_x",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r",
       "v"
      ],
      "ranges": {
       "r": {
        "from": "emis_records"
       },
       "v": {
        "from": "line_vertex"
       }
      },
      "args": [
       "line_lonlat"
      ],
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "lcc_forward_x",
       "bindings": {
        "lon": {
         "op": "index",
         "args": [
          "line_lonlat",
          "r",
          "v",
          1
         ]
        },
        "lat": {
         "op": "index",
         "args": [
          "line_lonlat",
          "r",
          "v",
          2
         ]
        }
       }
      }
     }
    },
    {
     "lhs": "line_y",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r",
       "v"
      ],
      "ranges": {
       "r": {
        "from": "emis_records"
       },
       "v": {
        "from": "line_vertex"
       }
      },
      "args": [
       "line_lonlat"
      ],
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "lcc_forward_y",
       "bindings": {
        "lon": {
         "op": "index",
         "args": [
          "line_lonlat",
          "r",
          "v",
          1
         ]
        },
        "lat": {
         "op": "index",
         "args": [
          "line_lonlat",
          "r",
          "v",
          2
         ]
        }
       }
      }
     }
    },
    {
     "lhs": "seg_xmin",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r"
      ],
      "ranges": {
       "r": {
        "from": "emis_records"
       }
      },
      "args": [
       "line_x"
      ],
      "expr": {
       "op": "min",
       "args": [
        {
         "op": "index",
         "args": [
          "line_x",
          "r",
          1
         ]
        },
        {
         "op": "index",
         "args": [
          "line_x",
          "r",
          2
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "seg_xmax",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r"
      ],
      "ranges": {
       "r": {
        "from": "emis_records"
       }
      },
      "args": [
       "line_x"
      ],
      "expr": {
       "op": "max",
       "args": [
        {
         "op": "index",
         "args": [
          "line_x",
          "r",
          1
         ]
        },
        {
         "op": "index",
         "args": [
          "line_x",
          "r",
          2
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "seg_ymin",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r"
      ],
      "ranges": {
       "r": {
        "from": "emis_records"
       }
      },
      "args": [
       "line_y"
      ],
      "expr": {
       "op": "min",
       "args": [
        {
         "op": "index",
         "args": [
          "line_y",
          "r",
          1
         ]
        },
        {
         "op": "index",
         "args": [
          "line_y",
          "r",
          2
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "seg_ymax",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r"
      ],
      "ranges": {
       "r": {
        "from": "emis_records"
       }
      },
      "args": [
       "line_y"
      ],
      "expr": {
       "op": "max",
       "args": [
        {
         "op": "index",
         "args": [
          "line_y",
          "r",
          1
         ]
        },
        {
         "op": "index",
         "args": [
          "line_y",
