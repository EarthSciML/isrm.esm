   "analyses": [
    {
     "id": "isrm_line_demo",
     "description": "Static evaluation of the line-source ISRM: TotalPM25 and attributable deaths at the N_RCV receptor cells, from a road emission layer allocated by segment/cell length overlap. Degenerate time span (no ODE integration).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "plots": [
      {
       "id": "totalpm25_map",
       "type": "scatter",
       "description": "TotalPM25 (ug/m3) vs receptor cell-centroid easting. The ISRM grid is an unstructured variable-resolution polygon mesh with a single flat index, so field_snapshot (structured lat-lon) does not apply and a polygon choropleth is out of format scope; scatter has no per-point colour channel, so the value is on the y-axis.",
       "x": {
        "variable": "rcv_cx",
        "label": "receptor centroid x (m, LCC)"
       },
       "y": {
        "variable": "TotalPM25",
        "label": "PM2.5 (ug/m3)"
       }
      }
     ]
    }
   ]
  }
