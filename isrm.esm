     "file_variable": "WindSpeed",
     "units": "m/s",
     "description": "Wind speed in each cell. Length 596444 (N_ALL), layer-major over all 27 model layers; read in full because plume rise gathers it at whichever layer a stack top sits in."
    },
    "WindSpeedInverse": {
