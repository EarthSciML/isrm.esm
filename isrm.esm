                  {
                   "op": "*",
                   "args": [
                    4,
                    "N_SRC"
                   ]
                  },
                  "c"
                 ]
                }
               ]
              },
              {
               "op": "index",
               "args": [
                "stk_height",
                "r"
               ]
              }
             ]
            },
            1.0,
            0.0
           ]
          }
         ]
        }
       ]
      }
     },
     "description": "Model layer the STACK TOP sits in, for the source cell that contains the record: InMAP's findLayer (sort.SearchFloat64s on the staggered LayerHeight column, minus one unless zero), which with LayerHeight[0]=0 is exactly the count of layer bottoms strictly below the stack. FOUR indicators is enough and is asserted by the inventory: the tallest EGU stack is 316.38 m and the lowest layer-4 bottom is 348.44 m, so the stack layer is always in {0,1,2,3}; four terms would still cover the tallest chimney on Earth (~419.7 m, against a lowest layer-5 bottom of 503.89 m). The leading containment indicator is the same spatial join E_* uses, so this picks the record's own cell and is 0 for a record outside the grid. IN-BOUNDS ARGUMENT, load-bearing: a sum of four indicators is at most 4, so the largest LayerHeight offset any of these observeds reaches is 4*52411 + 52410 = 262054 < 596444 = N_ALL. No clamp is needed, and none should be added on the assumption that one is missing \u2014 but do not widen the sum without redoing this arithmetic, because an out-of-range const-array gather is a hard error in all three bindings (Rust returned a silent 0.0 until EarthSciAST 5af33a14 made it raise E_TREEWALK_CONSTARRAY_OOB like the others)."
    },
