    },
    "LayerHeight": {
     "file_variable": "LayerHeight",
     "units": "m",
     "description": "Staggered layer-BOTTOM height: LayerHeight[l, c] is the height of the bottom of model layer l over cell c, and layer 0's is 0. This is the column InMAP's findLayer searches. Length 596444 (N_ALL), layer-major over all 27 model layers; read in full because plume rise gathers it at whichever layer a stack top sits in."
    }
   }
  },
  "ISRM_SR_L0": {
   "kind": "static",
   "source": {
