    },
    "Temperature": {
     "file_variable": "Temperature",
     "units": "K",
     "description": "Air temperature in each cell. Length 596444 (N_ALL), layer-major over all 27 model layers; read in full because plume rise gathers it at whichever layer a stack top sits in."
    },
