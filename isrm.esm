        596444
       ],
       "dtype": "<f8"
      }
     },
     "gated_select": {
      "_DRAFT": "Phase-2-core GATED-PROVIDER field (proposed). Replaces the runner's lazy_select ([0], ppl, :). Per-axis selection over the native SR dims sr_dim_order [emisLayer, source, receptor] = [3, 52411, 52411]; one axis is GATED BY a derived (value-invention) index set. Intended consumption: the engine DEFERS this provider's materialisation until materialize_value_invention has produced the gating set's members+extent, then delivers each `applies_to` array pre-sliced to the compact [emis_src_cells, rcv_cells] slab BEFORE the SR contraction (no 330 GB fold). Per-axis semantics: {\"fixed\":[i]} = take native index i and DROP the axis; {\"gated_by\":\"<derived index set>\"} = take that set's materialised members, in the set's canonical (sorted) member order, as the new axis (here emis_src_cells = the invented ppl); \"all\" = full axis (slice(None)).",
      "axes": [
       {
        "fixed": [
         0
        ]
       },
       {
        "gated_by": "emis_src_cells"
       },
       "all"
      ],
      "applies_to": [
       "SOA",
       "pNO3",
       "pNH4",
       "pSO4",
       "PrimaryPM25"
      ]
     },
     "note": "`format` and the pinned .zarray params are not expressible in the 0.8.0 source schema (G1); the runner sets format at provider creation. PUSHDOWN DRAFT: the SR source-axis slice is no longer the runner-threaded `ppl` lazy_select but the gated_select above, gated by the DERIVED emis_src_cells set the value-invention producer emis_src_cells_faq materialises (G2; Phase-2-core gated-provider deferral). W/S/E/N/TotalPop/MortalityRate are read fully (value-invention's rectangle filter reads the FULL grid); the first 52411 are the SR receptor/source cells, and that prefix is now DECLARED as the src_W/src_S/src_E/src_N variables' `select` range rather than sliced by the caller. NOTE: for the pushdown, W/S/E/N (full-grid cell rectangles) must also be available to value-invention as build-time const factors (the producer's rectangle filter reads index(W,c)..index(N,c) over the full source grid)."
    }
   },
   "variables": {
    "SOA": {
     "file_variable": "SOA",
     "units": "ug/m^3/(kg/yr)",
     "description": "SR secondary organic aerosol response (contracted with VOC emissions). SR response; native dims [emis_layer, src_cells, rcv_cells] (dtype <f4, chunks [1,100,52411]). Runner delivers only the lazy orthogonal slice ([0], ppl, :) => the compact [emis_src_cells, rcv_cells] slab (G2)."
    },
    "pNO3": {
     "file_variable": "pNO3",
     "units": "ug/m^3/(kg/yr)",
     "description": "SR particulate nitrate response (contracted with NOx emissions). SR response; native dims [emis_layer, src_cells, rcv_cells] (dtype <f4, chunks [1,100,52411]). Runner delivers only the lazy orthogonal slice ([0], ppl, :) => the compact [emis_src_cells, rcv_cells] slab (G2)."
    },
    "pNH4": {
     "file_variable": "pNH4",
     "units": "ug/m^3/(kg/yr)",
     "description": "SR particulate ammonium response (contracted with NH3 emissions). SR response; native dims [emis_layer, src_cells, rcv_cells] (dtype <f4, chunks [1,100,52411]). Runner delivers only the lazy orthogonal slice ([0], ppl, :) => the compact [emis_src_cells, rcv_cells] slab (G2)."
    },
    "pSO4": {
     "file_variable": "pSO4",
     "units": "ug/m^3/(kg/yr)",
     "description": "SR particulate sulfate response (contracted with SOx emissions). SR response; native dims [emis_layer, src_cells, rcv_cells] (dtype <f4, chunks [1,100,52411]). Runner delivers only the lazy orthogonal slice ([0], ppl, :) => the compact [emis_src_cells, rcv_cells] slab (G2)."
    },
    "PrimaryPM25": {
     "file_variable": "PrimaryPM25",
     "units": "ug/m^3/(kg/yr)",
     "description": "SR primary PM2.5 response (contracted with PM2_5 emissions). SR response; native dims [emis_layer, src_cells, rcv_cells] (dtype <f4, chunks [1,100,52411]). Runner delivers only the lazy orthogonal slice ([0], ppl, :) => the compact [emis_src_cells, rcv_cells] slab (G2)."
    },
    "W": {
     "file_variable": "W",
     "units": "m",
     "description": "Cell west edge (LCC metres); length 596444, first 52411 build the cell rectangles."
    },
    "S": {
     "file_variable": "S",
     "units": "m",
     "description": "Cell south edge (LCC metres); length 596444, first 52411 used."
    },
    "E": {
     "file_variable": "E",
     "units": "m",
     "description": "Cell east edge (LCC metres); length 596444, first 52411 used."
    },
    "N": {
     "file_variable": "N",
     "units": "m",
     "description": "Cell north edge (LCC metres); length 596444, first 52411 used."
    },
    "TotalPop": {
     "file_variable": "TotalPop",
     "units": "1",
     "description": "Population per cell; length 596444, prefix [0:52411] used in the deaths formula."
    },
    "MortalityRate": {
     "file_variable": "MortalityRate",
     "units": "1",
     "description": "Baseline all-cause mortality per 100,000; length 596444, prefix [0:52411] used."
    },
    "src_W": {
     "file_variable": "W",
     "units": "m",
     "select": {
      "axes": [
       {
        "range": {
         "start": 0,
         "stop": "N_SRC"
        }
       }
      ]
     },
     "description": "Cell west edge over the SOURCE cells: the SAME on-disk array as `W`, delivered as its [0:N_SRC] prefix. Declared, so no caller samples the grid a second time to slice it (esm-spec 8.9.2)."
    },
    "src_S": {
     "file_variable": "S",
     "units": "m",
     "select": {
      "axes": [
       {
        "range": {
         "start": 0,
         "stop": "N_SRC"
        }
       }
      ]
     },
     "description": "Cell south edge over the SOURCE cells: the SAME on-disk array as `S`, delivered as its [0:N_SRC] prefix. Declared, so no caller samples the grid a second time to slice it (esm-spec 8.9.2)."
    },
    "src_E": {
     "file_variable": "E",
     "units": "m",
     "select": {
      "axes": [
       {
        "range": {
         "start": 0,
         "stop": "N_SRC"
        }
       }
      ]
     },
     "description": "Cell east edge over the SOURCE cells: the SAME on-disk array as `E`, delivered as its [0:N_SRC] prefix. Declared, so no caller samples the grid a second time to slice it (esm-spec 8.9.2)."
    },
    "src_N": {
     "file_variable": "N",
     "units": "m",
     "select": {
      "axes": [
       {
        "range": {
         "start": 0,
         "stop": "N_SRC"
        }
       }
      ]
     },
     "description": "Cell north edge over the SOURCE cells: the SAME on-disk array as `N`, delivered as its [0:N_SRC] prefix. Declared, so no caller samples the grid a second time to slice it (esm-spec 8.9.2)."
    }
   }
  },
  "EGU_Emis": {
   "kind": "points",
   "source": {
    "url_template": "https://gaftp.epa.gov/air/emismod/2016/alpha/2016fd/emissions/2016fd_inputs_point.zip"
   },
   "reference": {
    "notes": "EPA 2016fd alpha point-source FF10 inventory (2016fd_inputs_point.zip)."
   },
   "metadata": {
    "esio_format": "ff10",
    "tags": [
     "nei",
     "ff10",
     "point_sources",
     "egu",
     "emissions"
    ],
    "x_esd": {
     "format": "ff10",
     "container": "zip",
     "member_filter": "*egu*",
     "skip_header_row": true,
     "crs": "EPSG:4269",
     "columns": {
      "pollutant": 12,
      "annual_tons": 13,
      "stkhgt_ft": 17,
      "stkdiam_ft": 18,
      "stktemp_F": 19,
      "stkvel_fps": 21,
      "lon": 23,
      "lat": 24
     },
     "pollutant_encoding": "Historical: the col-12 POLID string is now mapped by the loader variable's own `codes` map (esm-spec 8.9.1); `pollutant_codes` below is retained as the human-readable provenance of that map. The is_VOC/is_NOx/is_NH3/is_SOx/is_PM25 membership observeds compare `pollutant` against these integers (STEP 0.6 pollutant->pathway map).",
     "pollutant_codes": {
      "VOC": 1,
      "VOC_INV": 2,
      "XYL": 3,
      "TOL": 4,
      "TERP": 5,
      "PAR": 6,
      "OLE": 7,
      "NVOL": 8,
      "MEOH": 9,
      "ISOP": 10,
      "IOLE": 11,
      "FORM": 12,
      "ETOH": 13,
      "ETHA": 14,
      "ETH": 15,
      "ALD2": 16,
      "ALDX": 17,
      "CB05_ALD2": 18,
      "CB05_ALDX": 19,
      "CB05_BENZENE": 20,
      "CB05_ETH": 21,
      "CB05_ETHA": 22,
      "CB05_ETOH": 23,
      "CB05_FORM": 24,
      "CB05_IOLE": 25,
      "CB05_ISOP": 26,
      "CB05_MEOH": 27,
      "CB05_OLE": 28,
      "CB05_PAR": 29,
      "CB05_TERP": 30,
      "CB05_TOL": 31,
      "CB05_XYL": 32,
      "ETHANOL": 33,
      "NHTOG": 34,
      "NMOG": 35,
      "NOX": 36,
      "HONO": 37,
      "NO": 38,
      "NO2": 39,
      "NH3": 40,
      "SO2": 41,
      "PM25-PRI": 42,
      "PM2_5": 43,
      "DIESEL-PM25": 44,
      "PAL": 45,
      "PCA": 46,
      "PCL": 47,
      "PEC": 48,
      "PFE": 49,
      "PK": 50,
      "PMG": 51,
      "PMN": 52,
      "PMOTHR": 53,
      "PNH4": 54,
      "PNO3": 55,
      "POC": 56,
      "PSI": 57,
      "PSO4": 58,
      "PTI": 59
     },
     "note": "format=ff10, the zip container, the *egu* member filter and the numbered column map are the FF10 point schema's own; the loader now DECLARES its ingest (esm-spec 8.9): `reader_options` carries the member glob + header row, `codes` maps POLID to the pollutant enum with unrecognised codes dropping the record, `record_filter` drops a record with no coordinate or no annual total, and `extent` binds the surviving count to N_REC. G3 and G6 are CLOSED: no caller reads this table, maps its codes, filters its rows or counts them."
    }
   },
   "reader_options": {
    "member_glob": "*egu*",
    "skip_header_row": true
   },
   "record_filter": {
    "require_finite": [
     "lon",
     "lat",
     "annual"
    ]
   },
   "extent": {
    "metaparameter": "N_REC"
   },
   "variables": {
    "pollutant": {
     "file_variable": "POLID",
     "units": "1",
     "codes": {
