      ],
      "reduce": "+",
      "ranges": {
       "s": {
        "from": "src_cells"
       },
       "rcv": {
        "from": "rcv_cells"
       }
      },
      "args": [
       "SR_PrimaryPM25",
       "E_PM25"
      ],
      "expr": {
       "op": "*",
       "args": [
        {
         "op": "index",
         "args": [
          "SR_PrimaryPM25",
          "s",
          "rcv"
         ]
        },
        {
         "op": "index",
         "args": [
          "E_PM25",
          "s"
         ]
        }
       ]
      }
     },
     "description": "Per-receptor concentration response from the PrimaryPM25 pathway: sum_s SR_PrimaryPM25[s,rcv]*E_PM25[s] (pre-fact; emisLayer 0 already sliced out of SR)."
    },
    "TotalPM25": {
     "type": "observed",
     "units": "ug/m^3",
     "shape": [
