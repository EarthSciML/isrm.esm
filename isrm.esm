    "deathsK": {
     "type": "observed",
     "units": "1",
     "shape": [
      "rcv_cells"
     ],
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "rcv"
      ],
      "ranges": {
       "rcv": {
        "from": "rcv_cells"
       }
      },
      "args": [
       "TotalPM25",
       "TotalPop",
       "MortalityRate"
      ],
      "expr": {
       "op": "*",
       "args": [
        {
         "op": "*",
         "args": [
          {
           "op": "*",
           "args": [
            {
             "op": "-",
             "args": [
              {
               "op": "exp",
               "args": [
                {
                 "op": "*",
                 "args": [
                  {
                   "op": "/",
                   "args": [
                    {
                     "op": "log",
                     "args": [
                      "rr_K"
                     ]
                    },
                    10
                   ]
                  },
                  {
                   "op": "index",
                   "args": [
                    "TotalPM25",
                    "rcv"
                   ]
                  }
                 ]
                }
               ]
              },
              1
             ]
            },
            {
             "op": "*",
             "args": [
              {
               "op": "index",
               "args": [
                "TotalPop",
                "rcv"
               ]
              },
              "pop_scale"
             ]
            }
           ]
          },
          {
           "op": "/",
           "args": [
            {
             "op": "index",
             "args": [
              "MortalityRate",
              "rcv"
             ]
            },
            100000
           ]
          }
         ]
        },
        "mort_scale"
       ]
      }
     },
     "description": "Attributable deaths at each receptor (Krewski RR 1.06): (exp(log(rr)/10*TotalPM25)-1)*TotalPop*pop_scale*MortalityRate/100000*mort_scale. TotalPop/MortalityRate indexed on the rcv range = the [0:52411] prefix slice."
    },
