  "EGU_Emis": {
   "kind": "points",
   "source": {
    "url_template": "https://gaftp.epa.gov/air/emismod/2016/alpha/2016fd/emissions/2016fd_inputs_point.zip"
   },
   "reference": {
    "notes": "EPA 2016fd alpha point-source FF10 inventory (2016fd_inputs_point.zip)."
   },
   "metadata": {
    "esio_format": "ff10",
    "tags": [
     "nei",
     "ff10",
     "point_sources",
     "egu",
     "emissions"
    ],
    "x_esd": {
     "format": "ff10",
     "container": "zip",
     "member_filter": "*egu*",
     "skip_header_row": true,
     "crs": "EPSG:4269",
     "columns": {
      "pollutant": 12,
      "annual_tons": 13,
      "stkhgt_ft": 17,
      "stkdiam_ft": 18,
      "stktemp_F": 19,
      "stkvel_fps": 21,
      "lon": 23,
      "lat": 24
     },
     "pollutant_encoding": "Historical: the col-12 POLID string is now mapped by the loader variable's own `codes` map (esm-spec 8.9.1); `pollutant_codes` below is retained as the human-readable provenance of that map. The is_VOC/is_NOx/is_NH3/is_SOx/is_PM25 membership observeds compare `pollutant` against these integers (STEP 0.6 pollutant->pathway map).",
     "pollutant_codes": {
      "VOC": 1,
      "VOC_INV": 2,
      "XYL": 3,
      "TOL": 4,
      "TERP": 5,
      "PAR": 6,
      "OLE": 7,
      "NVOL": 8,
      "MEOH": 9,
      "ISOP": 10,
      "IOLE": 11,
      "FORM": 12,
      "ETOH": 13,
      "ETHA": 14,
      "ETH": 15,
      "ALD2": 16,
      "ALDX": 17,
      "CB05_ALD2": 18,
      "CB05_ALDX": 19,
      "CB05_BENZENE": 20,
      "CB05_ETH": 21,
      "CB05_ETHA": 22,
      "CB05_ETOH": 23,
      "CB05_FORM": 24,
      "CB05_IOLE": 25,
      "CB05_ISOP": 26,
      "CB05_MEOH": 27,
      "CB05_OLE": 28,
      "CB05_PAR": 29,
      "CB05_TERP": 30,
      "CB05_TOL": 31,
      "CB05_XYL": 32,
      "ETHANOL": 33,
      "NHTOG": 34,
      "NMOG": 35,
      "NOX": 36,
      "HONO": 37,
      "NO": 38,
      "NO2": 39,
      "NH3": 40,
      "SO2": 41,
      "PM25-PRI": 42,
      "PM2_5": 43,
      "DIESEL-PM25": 44,
      "PAL": 45,
      "PCA": 46,
      "PCL": 47,
      "PEC": 48,
      "PFE": 49,
      "PK": 50,
      "PMG": 51,
      "PMN": 52,
      "PMOTHR": 53,
      "PNH4": 54,
      "PNO3": 55,
      "POC": 56,
      "PSI": 57,
      "PSO4": 58,
      "PTI": 59
     },
     "note": "format=ff10, the zip container, the *egu* member filter and the numbered column map are the FF10 point schema's own; the loader now DECLARES its ingest (esm-spec 8.9): `reader_options` carries the member glob + header row, `codes` maps POLID to the pollutant enum with unrecognised codes dropping the record, `record_filter` drops a record with no coordinate or no annual total, and `extent` binds the surviving count to N_REC. G3 and G6 are CLOSED: no caller reads this table, maps its codes, filters its rows or counts them."
    }
   },
   "reader_options": {
    "member_glob": "*egu*",
    "skip_header_row": true
   },
   "record_filter": {
    "require_finite": [
     "lon",
     "lat",
     "annual"
    ]
   },
   "extent": {
    "metaparameter": "N_REC"
   },
   "variables": {
    "pollutant": {
     "file_variable": "POLID",
     "units": "1",
     "codes": {
      "map": {
       "VOC": 1,
       "VOC_INV": 2,
       "XYL": 3,
       "TOL": 4,
       "TERP": 5,
       "PAR": 6,
       "OLE": 7,
       "NVOL": 8,
       "MEOH": 9,
       "ISOP": 10,
       "IOLE": 11,
       "FORM": 12,
       "ETOH": 13,
       "ETHA": 14,
       "ETH": 15,
       "ALD2": 16,
       "ALDX": 17,
       "CB05_ALD2": 18,
       "CB05_ALDX": 19,
       "CB05_BENZENE": 20,
       "CB05_ETH": 21,
       "CB05_ETHA": 22,
       "CB05_ETOH": 23,
       "CB05_FORM": 24,
       "CB05_IOLE": 25,
       "CB05_ISOP": 26,
       "CB05_MEOH": 27,
       "CB05_OLE": 28,
       "CB05_PAR": 29,
       "CB05_TERP": 30,
       "CB05_TOL": 31,
       "CB05_XYL": 32,
       "ETHANOL": 33,
       "NHTOG": 34,
       "NMOG": 35,
       "NOX": 36,
       "HONO": 37,
       "NO": 38,
       "NO2": 39,
       "NH3": 40,
       "SO2": 41,
       "PM25-PRI": 42,
       "PM2_5": 43,
       "DIESEL-PM25": 44,
       "PAL": 45,
       "PCA": 46,
       "PCL": 47,
       "PEC": 48,
       "PFE": 49,
       "PK": 50,
       "PMG": 51,
       "PMN": 52,
       "PMOTHR": 53,
       "PNH4": 54,
       "PNO3": 55,
       "POC": 56,
       "PSI": 57,
       "PSO4": 58,
       "PTI": 59
      },
      "case_insensitive": true,
      "unmapped": "drop"
     },
     "description": "FF10 pollutant code (col 12, POLID), delivered as the `pollutant` enum integer by the loader's own `codes` map. A code outside the map is a pathway this model does not carry, so the record is dropped (record_filter semantics), which is exactly what the runner used to do by hand."
    },
    "annual": {
     "file_variable": "ANN_VALUE",
     "units": "short_ton/yr",
     "description": "Annual emissions (col 13), in SHORT TONS per year as the column stores it."
    },
    "stkhgt": {
     "file_variable": "STKHGT",
     "units": "ft",
     "description": "Stack height, FF10 col 17, in feet as the column stores it. Consumed by plume rise through `stk_height`, which converts it: it picks the stack's model layer, scales the unstable-buoyant rise, and a height of exactly 0 means the record emits at ground level without a plume at all."
    },
    "stkdiam": {
     "file_variable": "STKDIAM",
     "units": "ft",
     "description": "Stack inner diameter, FF10 col 18, in feet as the column stores it. Consumed by plume rise through `stk_diam`: it sets the buoyancy flux through (ds/2)^2 and the momentum-dominated rise directly."
    },
    "stktemp": {
     "file_variable": "STKTEMP",
     "units": "degF",
     "description": "Stack exit temperature, FF10 col 19, in degrees Fahrenheit as the column stores it. Consumed by plume rise through `stk_temp`: with the ambient temperature at the stack's layer it gives the buoyancy contrast, and Ts-Ta < 50 K is one of the three momentum-dominated conditions."
    },
    "stkvel": {
     "file_variable": "STKVEL",
     "units": "ft/s",
     "description": "Stack exit velocity, FF10 col 21, in feet per second as the column stores it. Consumed by plume rise through `stk_vel`: it carries the buoyancy flux, and vs > 10 m/s together with vs > u is what makes a plume momentum-dominated."
    },
    "lon": {
     "file_variable": "LONGITUDE",
     "units": "degree",
     "description": "Longitude (col 23), EPSG:4269 treated as +proj=longlat."
    },
    "lat": {
     "file_variable": "LATITUDE",
     "units": "degree",
     "description": "Latitude (col 24), EPSG:4269 treated as +proj=longlat."
    }
   }
  }
 },
 "models": {
  "ISRM": {
   "system_kind": "nonlinear",
   "reference": {
    "url": "https://inmap.run/blog/2022/12/15/tutorial/",
    "notes": "Pure algebraic (no ODE state); every result is an observed."
   },
   "variables": {
    "SR_SOA_L0": {
     "type": "parameter",
     "units": "ug/m^3/(kg/yr)",
     "default": 0.0,
     "shape": [
      "src_cells",
      "rcv_cells"
     ],
     "description": "Source-receptor matrix for the secondary organic aerosol pathway from emission layer 0 (contracted with the VOC mass whose plume reaches layer 0). Rows are the emission-bearing source cells the rewrite derives (emis_src_cells), columns the 52411 receptors. Wired from ISRM_SR_L0.SOA by param_to_var; the loader's own gated_select fixes the emission-layer axis, so this stays rank-2 (G2)."
    },
    "SR_SOA_L1": {
     "type": "parameter",
     "units": "ug/m^3/(kg/yr)",
     "default": 0.0,
     "shape": [
      "src_cells",
      "rcv_cells"
     ],
     "description": "Source-receptor matrix for the secondary organic aerosol pathway from emission layer 1 (contracted with the VOC mass whose plume reaches layer 1). Rows are the emission-bearing source cells the rewrite derives (emis_src_cells), columns the 52411 receptors. Wired from ISRM_SR_L1.SOA by param_to_var; the loader's own gated_select fixes the emission-layer axis, so this stays rank-2 (G2)."
    },
    "SR_SOA_L2": {
     "type": "parameter",
     "units": "ug/m^3/(kg/yr)",
     "default": 0.0,
     "shape": [
      "src_cells",
      "rcv_cells"
     ],
     "description": "Source-receptor matrix for the secondary organic aerosol pathway from emission layer 2 (contracted with the VOC mass whose plume reaches layer 2). Rows are the emission-bearing source cells the rewrite derives (emis_src_cells), columns the 52411 receptors. Wired from ISRM_SR_L2.SOA by param_to_var; the loader's own gated_select fixes the emission-layer axis, so this stays rank-2 (G2)."
    },
    "SR_pNO3_L0": {
     "type": "parameter",
     "units": "ug/m^3/(kg/yr)",
     "default": 0.0,
     "shape": [
      "src_cells",
      "rcv_cells"
     ],
     "description": "Source-receptor matrix for the particulate nitrate pathway from emission layer 0 (contracted with the NOx mass whose plume reaches layer 0). Rows are the emission-bearing source cells the rewrite derives (emis_src_cells), columns the 52411 receptors. Wired from ISRM_SR_L0.pNO3 by param_to_var; the loader's own gated_select fixes the emission-layer axis, so this stays rank-2 (G2)."
    },
