      },
      "pSO4": {
       "shape": [
        3,
        52411,
        52411
       ],
       "chunks": [
        1,
        100,
        52411
       ],
       "dtype": "<f4"
      },
      "PrimaryPM25": {
       "shape": [
        3,
        52411,
        52411
       ],
       "chunks": [
        1,
        100,
        52411
       ],
       "dtype": "<f4"
      },
      "TotalPop": {
       "shape": [
        596444
       ],
       "chunks": [
        596444
       ],
       "dtype": "<f8"
      },
      "MortalityRate": {
       "shape": [
        596444
       ],
       "chunks": [
        596444
       ],
       "dtype": "<f8"
      },
      "W": {
       "shape": [
        596444
       ],
       "chunks": [
        596444
       ],
       "dtype": "<f8"
      },
      "S": {
       "shape": [
