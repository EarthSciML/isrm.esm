       "POC": 56,
       "PSI": 57,
       "PSO4": 58,
       "PTI": 59
      },
      "case_insensitive": true,
      "unmapped": "drop"
     },
     "description": "FF10 pollutant code (col 12, POLID), delivered as the `pollutant` enum integer by the loader's own `codes` map. A code outside the map is a pathway this model does not carry, so the record is dropped (record_filter semantics), which is exactly what the runner used to do by hand."
    },
    "annual": {
     "file_variable": "ANN_VALUE",
     "units": "kg/yr",
     "description": "Annual emissions (col 13)."
    },
