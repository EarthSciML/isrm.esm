    "emis_lon": {
     "type": "parameter",
     "units": "degree",
     "default": 0.0,
     "shape": [
      "emis_records"
     ],
     "description": "Emission-point longitude (EPSG:4269); from EGU_Emis.lon."
    },
    "emis_lat": {
     "type": "parameter",
     "units": "degree",
     "default": 0.0,
     "shape": [
      "emis_records"
     ],
     "description": "Emission-point latitude (EPSG:4269); from EGU_Emis.lat."
    },
    "emis_annual": {
     "type": "parameter",
     "units": "short_ton/yr",
     "default": 0.0,
     "shape": [
      "emis_records"
     ],
     "description": "Per-record annual emissions in SHORT TONS per year, as the FF10 ANN_VALUE column stores them; from EGU_Emis.annual. `fact` is the short-ton/yr -> ug/s conversion applied once to the summed concentration."
    },
    "pollutant": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "emis_records"
     ],
     "description": "Per-record FF10 pollutant code as the `pollutant` enum integer; from EGU_Emis.pollutant."
    },
    "stkhgt": {
     "type": "parameter",
     "units": "ft",
     "default": 0.0,
     "shape": [
      "emis_records"
     ],
     "description": "Stack height as the FF10 column stores it, in FEET; from EGU_Emis.stkhgt. `stk_height` converts it to metres and that is what the physics reads - `stack_layer` (which model layer the stack top is in), `delta_h` (the h^2 in the unstable-buoyant rise) and `plume_layer` (a height of exactly 0 is InMAP's ground-level path)."
    },
    "stkdiam": {
     "type": "parameter",
     "units": "ft",
     "default": 0.0,
     "shape": [
      "emis_records"
     ],
     "description": "Stack inner diameter as the FF10 column stores it, in FEET; from EGU_Emis.stkdiam. `stk_diam` converts it; `buoy_flux` reads that as (ds/2)^2, as does the momentum-dominated branch of `delta_h`."
    },
    "stktemp": {
     "type": "parameter",
     "units": "degF",
     "default": 0.0,
     "shape": [
      "emis_records"
     ],
     "description": "Stack exit temperature as the FF10 column stores it, in degrees FAHRENHEIT; from EGU_Emis.stktemp. `stk_temp` converts it to kelvin; `temp_diff` reads that against the ambient temperature at the stack's own layer, and `delta_h` against the Ts-Ta < 50 K momentum test."
    },
    "stkvel": {
     "type": "parameter",
     "units": "ft/s",
     "default": 0.0,
     "shape": [
      "emis_records"
     ],
     "description": "Stack exit velocity as the FF10 column stores it, in FEET PER SECOND; from EGU_Emis.stkvel. `stk_vel` converts it to m/s; `buoy_flux` and both momentum tests in `delta_h` read that."
    },
    "W": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell west edge (LCC m); from ISRM_Grid.W (full 596444, prefix used)."
    },
    "S": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell south edge (LCC m); from ISRM_Grid.S."
    },
    "E": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell east edge (LCC m); from ISRM_Grid.E."
    },
    "N": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell north edge (LCC m); from ISRM_Grid.N."
    },
    "TotalPop": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Population per cell; from ISRM_Grid.TotalPop (read on the rcv range = [0:52411] prefix slice)."
    },
    "MortalityRate": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Baseline mortality per 100k; from ISRM_Grid.MortalityRate (prefix [0:52411])."
    },
    "Temperature": {
     "type": "parameter",
     "units": "K",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Air temperature in each cell. From ISRM_Grid.Temperature: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c."
    },
    "WindSpeed": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Wind speed in each cell. From ISRM_Grid.WindSpeed: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c."
    },
    "WindSpeedInverse": {
     "type": "parameter",
     "units": "s/m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell mean of 1/u, the average InMAP takes over the wind rose rather than the reciprocal of the mean speed. From ISRM_Grid.WindSpeedInverse: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c."
    },
    "WindSpeedMinusThird": {
     "type": "parameter",
     "units": "(m/s)^(-1/3)",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell mean of u^(-1/3). From ISRM_Grid.WindSpeedMinusThird: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c."
    },
    "WindSpeedMinusOnePointFour": {
     "type": "parameter",
     "units": "(m/s)^-1.4",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell mean of u^(-1.4). From ISRM_Grid.WindSpeedMinusOnePointFour: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c."
    },
    "S1": {
     "type": "parameter",
     "units": "1/s^2",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Stability parameter S1 = (g/theta) dtheta/dz, the buoyancy frequency squared that scales the stable-plume rise. From ISRM_Grid.S1: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c."
    },
    "SClass": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Stability class indicator: > 0.5 marks a stably stratified cell. From ISRM_Grid.SClass: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c."
    },
    "LayerHeight": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Staggered layer-BOTTOM height: LayerHeight[l, c] is the height of the bottom of model layer l over cell c, and layer 0's is 0. This is the column InMAP's findLayer searches. From ISRM_Grid.LayerHeight: one value per cell of the full 596444-cell grid, layer-major over the 27 model layers, so `l*N_SRC + c` reaches layer l of source cell c."
    },
    "fact": {
     "type": "parameter",
     "units": "1",
     "default": 28766.639396245562,
     "description": "short_ton/year emission-unit -> ug/m3 scaling (applied once to the summed concentration). Exactly InMAP's emisConversionFactor, 907184740000 / (3600*8760) \u2014 8760 h/yr, not 365.25 d."
    },
    "pop_scale": {
     "type": "parameter",
     "units": "1",
     "default": 1.0465819687408728,
     "description": "Population 2010->2016 rescale."
    },
    "mort_scale": {
     "type": "parameter",
     "units": "1",
     "default": 1.025229357798165,
     "description": "Mortality-rate 2005->2016 rescale."
    },
    "rr_K": {
     "type": "parameter",
     "units": "1",
     "default": 1.06,
     "description": "Krewski relative risk per 10 ug/m3 PM2.5."
    },
    "rr_L": {
     "type": "parameter",
     "units": "1",
     "default": 1.14,
     "description": "Lepeule relative risk per 10 ug/m3 PM2.5."
    },
    "lat_1": {
     "type": "parameter",
     "units": "degree",
     "default": 33.0,
     "description": "LCC standard parallel 1 (NEI2016)."
    },
    "lat_2": {
     "type": "parameter",
     "units": "degree",
     "default": 45.0,
     "description": "LCC standard parallel 2 (NEI2016)."
    },
    "lat_0": {
     "type": "parameter",
     "units": "degree",
     "default": 40.0,
     "description": "LCC origin latitude (NEI2016)."
    },
    "lon_0": {
     "type": "parameter",
     "units": "degree",
     "default": -97.0,
     "description": "LCC central meridian (NEI2016)."
    },
    "lcc_R": {
     "type": "parameter",
     "units": "m",
     "default": 6370997.0,
     "description": "LCC sphere radius (NEI2016). (Named lcc_R, not R, to avoid the reserved physical-constant name R = ideal gas constant.)"
    },
    "lcc_d2r": {
     "type": "parameter",
     "default": 0.017453292519943295,
     "description": "degrees->radians (pi/180) for the LCC projection."
    },
    "lcc_qp": {
     "type": "parameter",
     "default": 0.7853981633974483,
     "description": "pi/4 quarter-turn offset for the LCC tan half-angle."
    },
    "src_W": {
     "type": "parameter",
     "shape": [
      "src_cells"
     ],
     "description": "source-cell rectangle W-edge (projected LCC meters), src_cells axis."
    },
    "src_S": {
     "type": "parameter",
     "shape": [
      "src_cells"
     ],
     "description": "source-cell rectangle S-edge (projected LCC meters), src_cells axis."
    },
    "src_E": {
     "type": "parameter",
     "shape": [
      "src_cells"
     ],
     "description": "source-cell rectangle E-edge (projected LCC meters), src_cells axis."
    },
    "src_N": {
     "type": "parameter",
     "shape": [
      "src_cells"
     ],
     "description": "source-cell rectangle N-edge (projected LCC meters), src_cells axis."
    },
