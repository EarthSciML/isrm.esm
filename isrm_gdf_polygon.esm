   "analyses": [
    {
     "id": "isrm_polygon_demo",
     "description": "Static evaluation of the area-source ISRM: TotalPM25 and attributable deaths at the N_RCV receptor cells, from an area emission layer allocated by polygon/cell overlap. Degenerate time span (no ODE integration).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
