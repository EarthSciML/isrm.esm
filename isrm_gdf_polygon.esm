   },
   "equations": [
    {
     "lhs": "poly_x",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r",
       "v"
      ],
      "ranges": {
       "r": {
        "from": "emis_records"
       },
       "v": {
        "from": "poly_vertex"
       }
      },
      "args": [
       "poly_lonlat"
      ],
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "lcc_forward_x",
       "bindings": {
        "lon": {
         "op": "index",
         "args": [
          "poly_lonlat",
          "r",
          "v",
          1
         ]
        },
        "lat": {
         "op": "index",
         "args": [
          "poly_lonlat",
          "r",
          "v",
          2
         ]
        }
       }
      }
     }
    },
    {
     "lhs": "poly_y",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r",
       "v"
      ],
      "ranges": {
       "r": {
        "from": "emis_records"
       },
       "v": {
        "from": "poly_vertex"
       }
      },
      "args": [
       "poly_lonlat"
      ],
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "lcc_forward_y",
       "bindings": {
        "lon": {
         "op": "index",
         "args": [
          "poly_lonlat",
          "r",
          "v",
          1
         ]
        },
        "lat": {
         "op": "index",
         "args": [
          "poly_lonlat",
          "r",
          "v",
          2
         ]
        }
       }
      }
     }
    },
    {
     "lhs": "poly_ring",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r",
       "v",
       "d"
      ],
      "ranges": {
       "r": {
        "from": "emis_records"
       },
       "v": {
        "from": "poly_vertex"
       },
       "d": {
        "from": "xy"
       }
      },
      "args": [
       "poly_x",
       "poly_y"
      ],
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "ring_xy",
       "bindings": {
        "x": {
         "op": "index",
         "args": [
          "poly_x",
          "r",
          "v"
         ]
        },
        "y": {
         "op": "index",
         "args": [
          "poly_y",
          "r",
          "v"
         ]
        }
       }
      }
     }
    },
    {
     "lhs": "poly_xmin",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r"
      ],
      "reduce": "min",
      "ranges": {
       "r": {
        "from": "emis_records"
       },
       "v": {
        "from": "poly_vertex"
       }
      },
      "args": [
       "poly_x"
      ],
      "expr": {
       "op": "index",
       "args": [
        "poly_x",
        "r",
        "v"
       ]
      }
     }
    },
    {
     "lhs": "poly_xmax",
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "r"
      ],
      "reduce": "max",
