      "rcv_cells"
     ],
     "description": "Per-receptor concentration response from the pNH4 pathway: the layer-0 SR matrix contracted with the per-cell emissions. One contraction rather than the point document's three, because an area or line source reaches only emission layer 0."
    },
    "pm_pNH4": {
     "type": "unknown",
     "units": "ug/m^3",
     "shape": [
      "rcv_cells"
     ],
     "description": "Reported pNH4 PM2.5 component at each receptor: fact*conc_pNH4."
    },
    "SR_pSO4_L0": {
     "type": "parameter",
     "units": "ug/m^3/(kg/yr)",
     "default": 0.0,
     "shape": [
      "src_cells",
      "rcv_cells"
     ],
     "description": "Source-receptor matrix for the pSO4 pathway from emission layer 0. Rows are the emission-bearing source cells the projection-pushdown rewrite derives, columns the N_RCV receptors. Wired from ISRM_SR_L0.pSO4; the loader's own gated_select fixes the emission-layer axis, so this stays rank-2.",
     "update": {
      "kind": "data",
      "source": "ISRM_SR_L0",
      "from": {
       "file_variable": "pSO4"
      }
     }
    },
