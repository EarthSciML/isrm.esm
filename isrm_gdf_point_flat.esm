      "from": {
       "file_variable": "W"
      }
     }
    },
    "S": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell south edge (LCC m); from ISRM_Grid.S.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "S"
      }
     }
    },
    "E": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
