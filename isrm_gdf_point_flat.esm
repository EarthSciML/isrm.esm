     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "E"
      }
     }
    },
    "N": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Cell north edge (LCC m); from ISRM_Grid.N.",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "N"
      }
     }
    },
    "TotalPop": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Population per cell; from ISRM_Grid.TotalPop (read on the rcv range = [0:52411] prefix slice).",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "TotalPop"
      }
     }
    },
    "MortalityRate": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "all_cells"
     ],
     "description": "Baseline mortality per 100k; from ISRM_Grid.MortalityRate (prefix [0:52411]).",
     "update": {
      "kind": "data",
      "source": "ISRM_Grid",
      "from": {
       "file_variable": "MortalityRate"
      }
     }
    },
    "fact": {
     "type": "parameter",
     "units": "1",
     "default": 31.709791983764585,
     "description": "kg/yr -> ug/s: 1e9 ug/kg over 3.1536e7 s/yr. The published documents' 28766.639396245562 is this times 907.18474 kg per short ton, so reading SI changes this constant and nothing else."
    },
    "pop_scale": {
     "type": "parameter",
     "units": "1",
     "default": 1.0465819687408728,
     "description": "Population 2010->2016 rescale."
    },
    "mort_scale": {
     "type": "parameter",
     "units": "1",
     "default": 1.025229357798165,
     "description": "Mortality-rate 2005->2016 rescale."
    },
    "rr_K": {
     "type": "parameter",
     "units": "1",
     "default": 1.06,
     "description": "Krewski relative risk per 10 ug/m3 PM2.5."
    },
    "rr_L": {
     "type": "parameter",
     "units": "1",
     "default": 1.14,
     "description": "Lepeule relative risk per 10 ug/m3 PM2.5."
    },
    "lat_1": {
     "type": "parameter",
     "units": "degree",
     "default": 33.0,
     "description": "LCC standard parallel 1 (NEI2016)."
    },
    "lat_2": {
     "type": "parameter",
     "units": "degree",
     "default": 45.0,
     "description": "LCC standard parallel 2 (NEI2016)."
    },
    "lat_0": {
     "type": "parameter",
     "units": "degree",
     "default": 40.0,
