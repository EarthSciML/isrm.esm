    },
    "rcv_N": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "rcv_cells"
     ],
     "description": "Receptor cell rectangle north edge in LCC metres: the [0:52411] prefix of the full-grid N. Written so a run's output store carries the geometry its fields are over — a field over rcv_cells is not drawable without it."
    },
    "emis_lonlat": {
     "type": "parameter",
     "units": "degree",
     "default": 0.0,
     "shape": [
      "emis_records",
      "emis_vertex",
      "xy"
     ],
     "description": "Every source's coordinate as the shapefile stores it: [record, vertex, component] in the file's own CRS (EPSG:4269 lon/lat). Component 1 is longitude and component 2 latitude. From Emis.geometry. A point shapefile has one vertex per record, so the vertex axis is length 1 — the same geometry variable the area and line documents read, at its degenerate width.",
     "update": {
      "kind": "data",
      "source": "Emis",
      "from": {
       "file_variable": "geometry"
      }
     }
    },
    "emis_PM25": {
     "type": "parameter",
     "units": "kg/yr",
     "default": 0.0,
     "shape": [
      "emis_records"
     ],
     "description": "Each point's annual PM25 emission in kilograms per year, from Emis.PM25. It feeds the PrimaryPM25 pathway. Absent from the caller's frame this column is not written and the pathway is pruned from the document, so a variable that survives here always has a column behind it. `fact` is the kg/yr -> ug/s conversion, applied once to the summed concentration.",
     "update": {
      "kind": "data",
      "source": "Emis",
      "from": {
       "file_variable": "PM25"
      }
     }
    },
    "emis_VOC": {
